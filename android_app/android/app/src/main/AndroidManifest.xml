<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Downloads keep running while the screen is off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- Background downloads: foreground service + its notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Finished downloads are published to the Gallery (Movies/MY IPTV).
         Asked for at the first download, after an in-app explanation. -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO"/>
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"/>

    <!-- Android TV is a first-class target (spec 36). A TV has no
         touchscreen and no camera, so neither may be required or the app is
         filtered out of the TV Play Store listing. leanback is declared
         not-required so the SAME apk still installs on phones/tablets. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false"/>
    <uses-feature
        android:name="android.software.leanback"
        android:required="false"/>
    <uses-feature
        android:name="android.hardware.faketouch"
        android:required="false"/>

    <application
        android:label="MY IPTV"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:banner="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true"
        android:requestLegacyExternalStorage="true">
        <!-- usesCleartextTraffic: Xtream panels are routinely plain http on a
             custom port (the design reference shows http://otv.to). Spec 51
             asks for HTTPS "where supported"; refusing http outright would
             make the app unable to talk to most providers. -->

        <!-- Impeller (Flutter's Vulkan/GLES renderer, on by default) produces
             a permanent black screen on some real Android 14 devices with
             quirky GPU drivers (observed on an Oppo/ColorOS handset: engine
             logs show it initialising BOTH the Vulkan and GLES Impeller
             backends and repeatedly reporting "Width is zero. 0,0" for the
             render surface — nothing ever paints, no crash, no error). The
             older Skia backend does not have this problem on that hardware.
             Do not remove this without confirming Impeller actually renders
             on real (not just emulator) hardware first — see CLAUDE.md's
             media_kit hwdec note for the same kind of "works on emulator,
             black/broken on a real device" GPU issue. -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Phones and tablets. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Android TV launcher. Without this the app never appears on
                 the TV home screen. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Keeps the process (and the cached Flutter engine running the
             DownloadManager) alive while downloads are active, including
             after the app is swiped from recents. -->
        <service
            android:name=".DownloadService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="dataSync"/>
        <!-- FCM data-message announcements (AnnouncementNotifier.kt). Gets the
             same broadcast as firebase_messaging's own receiver; inert until
             google-services.json is added. -->
        <receiver
            android:name=".AnnouncementPushReceiver"
            android:exported="true"
            android:permission="com.google.android.c2dm.permission.SEND">
            <intent-filter>
                <action android:name="com.google.android.c2dm.intent.RECEIVE"/>
            </intent-filter>
        </receiver>
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- url_launcher needs this to open the WhatsApp purchase handoff. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
